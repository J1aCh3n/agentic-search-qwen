# Copy this file to .env and add your own API key.

DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.6-plus-2026-04-02

# Embedding model used for the Chroma vector store. Changing it requires
# deleting data/vector_db/ and running seed_data_large.py again.
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

# Model used by the LLM judges in evals/. Use a dated snapshot so scores stay comparable,
# and re-run `python -m evals.judge_answers --calibrate` after changing it.
DASHSCOPE_JUDGE_MODEL=qwen3.7-plus-2026-05-26

# Vector results with a cosine distance above this value are dropped.
# Lower is stricter. Re-calibrate after changing the embedding model or documents.
VECTOR_DISTANCE_THRESHOLD=0.70
